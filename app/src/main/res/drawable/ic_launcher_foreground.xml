<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Attendance Ring Glow -->
    <path
        android:pathData="M54,27 C68.91,27 81,39.09 81,54 C81,68.91 68.91,81 54,81 C39.09,81 27,68.91 27,54"
        android:strokeWidth="5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Dotted track remaining -->
    <path
        android:pathData="M27,54 C27,39.09 39.09,27 54,27"
        android:strokeWidth="5"
        android:strokeColor="#336366F1"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Center Graduation Cap / Academic Diamond Shield -->
    <!-- Cap top diamond -->
    <path
        android:pathData="M54,39 L72,47 L54,55 L36,47 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="39"
                android:endX="72"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#E0E7FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cap skull base / under arc -->
    <path
        android:pathData="M43,51.5 L43,59 C43,64 54,66 54,66 C54,66 65,64 65,59 L65,51.5 L54,56 Z"
        android:fillColor="#C7D2FE" />

    <!-- Tassel hanging down -->
    <path
        android:pathData="M67,49 L71,53 L71,63"
        android:strokeWidth="2"
        android:strokeColor="#F59E0B"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Checkmark inside attendance ring at bottom right -->
    <path
        android:pathData="M48,68 L53,73 L63,61"
        android:strokeWidth="3.5"
        android:strokeColor="#10B981"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
